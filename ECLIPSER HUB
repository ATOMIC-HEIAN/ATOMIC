-- ==================== LOGIC AUTO WIN EVADE (PARTS TREN TROI) ====================
local runningAutoWin = false
local SafePlatform = nil

local function EnableAutoWin()
    if not SafePlatform or not SafePlatform.Parent then
        SafePlatform = Instance.new("Part")
        SafePlatform.Name = "EclipserEvadeSafeZone"
        SafePlatform.Size = Vector3.new(30, 2, 30)
        SafePlatform.Position = Vector3.new(0, 500, 0) -- Do cao an toan tren troi
        SafePlatform.Anchored = true
        SafePlatform.CanCollide = true
        SafePlatform.Material = Enum.Material.SmoothPlastic
        SafePlatform.Color = Color3.fromRGB(30, 30, 30)
        SafePlatform.Parent = workspace
    end

    task.spawn(function()
        while runningAutoWin do
            local char = plr.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local hrp = char.HumanoidRootPart
                -- Instant TP len giua Part an toan
                if (hrp.Position - (SafePlatform.Position + Vector3.new(0, 3, 0))).Magnitude > 5 then
                    hrp.CFrame = SafePlatform.CFrame + Vector3.new(0, 3, 0)
                end
            end
            task.wait(0.1)
        end
    end)
end

local function DisableAutoWin()
    if SafePlatform then
        SafePlatform:Destroy()
        SafePlatform = nil
    end
    -- Teleport ve vi tri mat dat ngau nhien khi tat
    local char = plr.Character
    if char and char:FindFirstChild("HumanoidRootPart") then
        local randomX = math.random(-50, 50)
        local randomZ = math.random(-50, 50)
        char.HumanoidRootPart.CFrame = CFrame.new(randomX, 5, randomZ)
    end
end

