local function GetEvadeRealData()
    local realTokens = nil
    local realLevel = nil

    if plr:GetAttribute("Tokens") then realTokens = plr:GetAttribute("Tokens") end
    if plr:GetAttribute("Token") then realTokens = plr:GetAttribute("Token") end
    if plr:GetAttribute("Level") then realLevel = plr:GetAttribute("Level") end

    local dataFolder = plr:FindFirstChild("PlayerData") or plr:FindFirstChild("Data") or plr:FindFirstChild("stats")
    if dataFolder then
        local tVal = dataFolder:FindFirstChild("Tokens") or dataFolder:FindFirstChild("Token") or dataFolder:FindFirstChild("Point")
        local lVal = dataFolder:FindFirstChild("Level") or dataFolder:FindFirstChild("LVL")
        if tVal then realTokens = tVal.Value end
        if lVal then realLevel = lVal.Value end
    end

    local leaderstats = plr:FindFirstChild("leaderstats")
    if leaderstats then
        local tVal = leaderstats:FindFirstChild("Tokens") or leaderstats:FindFirstChild("Token") or leaderstats:FindFirstChild("Money") or leaderstats:FindFirstChild("Cash")
        local lVal = leaderstats:FindFirstChild("Level") or leaderstats:FindFirstChild("LVL")
        if tVal and not realTokens then realTokens = tVal.Value end
        if lVal and not realLevel then realLevel = lVal.Value end
    end

    realTokens = realTokens or 0
    realLevel = realLevel or 18

    return realTokens, realLevel
end

task.spawn(function()
    while true do
        local tokens, level = GetEvadeRealData()
        StatsDisplay.Text = string.format("💵 Tokens: %s  |  ⭐ Level: %s", tostring(tokens), tostring(level))
        task.wait(0.5)
    end
end)

