local SavedCF = nil
local AutoTPOn, AutoTPD = false, 0
CreateButton(PlayerTab, LangData[CurrentLang]["SavePos"], function()
    if SavedCF ~= nil then return end
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if hrp then SavedCF = hrp.CFrame end
end)
CreateButton(PlayerTab, LangData[CurrentLang]["TPPos"], function()
    local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if hrp and SavedCF then hrp.CFrame = SavedCF end
end)
CreateToggle(PlayerTab, LangData[CurrentLang]["AutoTP"], function(v)
    AutoTPOn = v
    task.spawn(function()
        while AutoTPOn and SavedCF do
            local hrp = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
            if hrp then hrp.CFrame = SavedCF end
            task.wait(AutoTPD)
        end
    end)
end)
CreateInput(PlayerTab, LangData[CurrentLang]["AutoTPSec"], function(t) if tonumber(t) then AutoTPD = math.clamp(tonumber(t), 0, 100) end end)
CreateButton(PlayerTab, LangData[CurrentLang]["DeletePos"], function() SavedCF = nil end)

-- ==================== TAB 3: VISUAL ====================
local VisualTab = containers["visual"]
local FixPct = 10
CreateInput(VisualTab, LangData[CurrentLang]["CustomFixLag"], function(t) if tonumber(t) then FixPct = math.clamp(tonumber(t), 10, 90) end end)
CreateButton(VisualTab, LangData[CurrentLang]["ApplyFixLag"], function()
    local targets = {}
    for _, obj in pairs(Workspace:GetDescendants()) do
        if obj:IsA("Decal") or obj:IsA("Texture") or (obj:IsA("BasePart") and not obj.CanCollide) then
            table.insert(targets, obj)
        end
    end
    for i = 1, math.floor(#targets * (FixPct / 100)) do if targets[i] then targets[i]:Destroy() end end
end)
CreateButton(VisualTab, LangData[CurrentLang]["NormalFixLag"], function()
    for _, o in pairs(Workspace:GetDescendants()) do if o:IsA("BasePart") then o.Material = Enum.Material.SmoothPlastic end end
end)
CreateButton(VisualTab, LangData[CurrentLang]["SuperFixLag"], function()
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 9e9
    for _, o in pairs(Workspace:GetDescendants()) do if o:IsA("BasePart") then o.Material = Enum.Material.SmoothPlastic end end
end)
CreateButton(VisualTab, LangData[CurrentLang]["UltraFixLag"], function()
    Lighting.GlobalShadows = false
    Lighting.FogEnd = 9e9
    for _, o in pairs(Workspace:GetDescendants()) do
        if o:IsA("ParticleEmitter") or o:IsA("Smoke") or o:IsA("Fire") or o:IsA("Sparkles") or o:IsA("Decal") or o:IsA("Texture") then
            o:Destroy()
        elseif o:IsA("BasePart") then
            o.Material = Enum.Material.SmoothPlastic
            o.Color = Color3.fromRGB(120, 120, 120)
        end
    end
end)
CreateToggle(VisualTab, LangData[CurrentLang]["Xray"], function(v)
    for _, o in pairs(Workspace:GetDescendants()) do if o:IsA("BasePart") and not o.Parent:FindFirstChild("Humanoid") then o.LocalTransparencyModifier = v and 0.6 or 0 end end
end)
CreateToggle(VisualTab, LangData[CurrentLang]["InfZoom"], function(v) LocalPlayer.CameraMaxZoomDistance = v and 999999 or 128 end)

