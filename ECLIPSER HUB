local function GetUniversalRealData()
    local realMoney, realLevel = nil, nil
    if plr:GetAttribute("Tokens") then realMoney = plr:GetAttribute("Tokens") end
    if plr:GetAttribute("Money") then realMoney = plr:GetAttribute("Money") end
    if plr:GetAttribute("Level") then realLevel = plr:GetAttribute("Level") end

    local dataFolder = plr:FindFirstChild("PlayerData") or plr:FindFirstChild("Data") or plr:FindFirstChild("stats")
    if dataFolder then
        local mVal = dataFolder:FindFirstChild("Tokens") or dataFolder:FindFirstChild("Money") or dataFolder:FindFirstChild("Cash")
        local lVal = dataFolder:FindFirstChild("Level") or dataFolder:FindFirstChild("LVL")
        if mVal then realMoney = mVal.Value end
        if lVal then realLevel = lVal.Value end
    end

    local leaderstats = plr:FindFirstChild("leaderstats")
    if leaderstats then
        local mVal = leaderstats:FindFirstChild("Tokens") or leaderstats:FindFirstChild("Money") or leaderstats:FindFirstChild("Cash")
        local lVal = leaderstats:FindFirstChild("Level") or leaderstats:FindFirstChild("LVL")
        if mVal and not realMoney then realMoney = mVal.Value end
        if lVal and not realLevel then realLevel = lVal.Value end
    end
    return realMoney or 0, realLevel or 1
end

