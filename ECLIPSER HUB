-- ==================== 4. HÀM DỊCH CHUYỂN TỨC THÌ 0S ====================
local lastTPTime = 0
local function TriggerInstantTP()
    if not SavedCFrame then return end
    if tick() - lastTPTime < 1 then return end -- Chống spam vụn
    lastTPTime = tick()

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    if hrp then
        StatusText.Text = LangData[CurrentLang]["Detected"]
        hrp.CFrame = SavedCFrame -- Instant TP 0s
        task.wait(0.1)
        hrp.CFrame = SavedCFrame -- Double Check chống rollback
        StatusText.Text = LangData[CurrentLang]["Done"]
        task.wait(1.5)
        StatusText.Text = LangData[CurrentLang]["CheckPet"]
    end
end

-- ==================== 5. ĐÀO SÂU QUÉT HỆ THỐNG GAME ====================

-- CÁCH 1: Bắt sự kiện RemoteEvent trong ReplicatedStorage (Chuyên dùng cho Break/Steal Egg)
task.spawn(function()
    for _, v in pairs(ReplicatedStorage:GetDescendants()) do
        if v:IsA("RemoteEvent") or v:IsA("UnreliableRemoteEvent") then
            local name = string.lower(v.Name)
            if string.find(name, "steal") or string.find(name, "egg") or string.find(name, "pet") or string.find(name, "grab") or string.find(name, "take") then
                v.OnClientEvent:Connect(function(...)
                    TriggerInstantTP()
                end)
            end
        end
    end
end)

-- CÁCH 2: Quét Attribute và Value biến đổi trên Character (Dấu hiệu đang ôm/vác trứng)
local function HookCharacter(char)
    if not char then return end

    -- Lắng nghe xem game có gắn Attribute như "Holding", "HasEgg", "Carrying" vào nhân vật không
    char.AttributeChanged:Connect(function(attr)
        local attrLower = string.lower(attr)
        if string.find(attrLower, "egg") or string.find(attrLower, "hold") or string.find(attrLower, "carry") or string.find(attrLower, "pet") or string.find(attrLower, "steal") then
            if char:GetAttribute(attr) == true or char:GetAttribute(attr) == 1 then
                TriggerInstantTP()
            end
        end
    end)

    -- Lắng nghe ChildAdded (Chất trứng/vật phẩm vào người)
    char.ChildAdded:Connect(function(child)
        local cName = string.lower(child.Name)
        if child:IsA("Tool") or child:IsA("Model") or string.find(cName, "egg") or string.find(cName, "pet") or string.find(cName, "carrier") then
            TriggerInstantTP()
        end
    end)
end

if LocalPlayer.Character then HookCharacter(LocalPlayer.Character) end
LocalPlayer.CharacterAdded:Connect(HookCharacter)

-- CÁCH 3: Quét Backpack (Túi đồ)
local function HookBackpack(bp)
    if not bp then return end
    bp.ChildAdded:Connect(function(child)
        local cName = string.lower(child.Name)
        if string.find(cName, "egg") or string.find(cName, "pet") then
            TriggerInstantTP()
        end
    end)
end
if LocalPlayer:FindFirstChildOfClass("Backpack") then HookBackpack(LocalPlayer:FindFirstChildOfClass("Backpack")) end
LocalPlayer.ChildAdded:Connect(function(child)
    if child:IsA("Backpack") then HookBackpack(child) end
end)

