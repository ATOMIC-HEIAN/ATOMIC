task.spawn(function()
    local lastTime = tick()
    local frameCount = 0
    local fps = 60

    RunService.RenderStepped:Connect(function()
        frameCount = frameCount + 1
        local now = tick()
        if now - lastTime >= 1 then
            fps = frameCount
            frameCount = 0
            lastTime = now
        end
    end)

    while true do
        local ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
        local ms = math.floor((1 / math.max(fps, 1)) * 1000)
        MetricsText.Text = string.format("Fps: %d | Ms: %dms | Ping: %dms", fps, ms, ping)
        task.wait(0.5)
    end
end)

