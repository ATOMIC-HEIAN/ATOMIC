CreateInput(PlayerTab, "JumpPower Value", function(t) if tonumber(t) then JmpVal = tonumber(t) end end)

CreateToggle(PlayerTab, LangData[CurrentLang]["GodMode"], function(v)
    if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
        LocalPlayer.Character.HumanoidRootPart.CFrame = v and (LocalPlayer.Character.HumanoidRootPart.CFrame + Vector3.new(0, 500, 0)) or LocalPlayer.Character.HumanoidRootPart.CFrame
