local function UpdateLanguage(lang)
    CurrentLang = lang
    if CurrentLang == "EN" then
        BtnEN.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        BtnEN.TextColor3 = Color3.fromRGB(0, 0, 0)
        BtnVN.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        BtnVN.TextColor3 = Color3.fromRGB(255, 255, 255)
    else
        BtnVN.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
        BtnVN.TextColor3 = Color3.fromRGB(0, 0, 0)
        BtnEN.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
        BtnEN.TextColor3 = Color3.fromRGB(255, 255, 255)
    end

    -- Đổi chữ trên các UI sang đúng ngôn ngữ chọn
    SaveBtn.Text = LangData[CurrentLang]["SavePos"]
    TPBtn.Text = LangData[CurrentLang]["TPPos"]
    MoveBtn.Text = LangData[CurrentLang]["MoveToPos"]
    lblAutoTP.Text = LangData[CurrentLang]["AutoTP"]
    AutoTPInput.PlaceholderText = LangData[CurrentLang]["AutoTPSec"]
    FlySpeedInput.PlaceholderText = LangData[CurrentLang]["FlySpeedInput"]
end

BtnEN.MouseButton1Click:Connect(function() UpdateLanguage("EN") end)
