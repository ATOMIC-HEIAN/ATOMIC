-- ==================== 5. CHỨC NĂNG PHÁT HIỆN TRỘM PET THẬT TRONG GAME ====================
local isFlyingBack = false

local function FlyBackToBase()
    if not SavedCFrame or isFlyingBack then return end
    isFlyingBack = true

    -- Đợi theo số giây cài đặt (0-3s)
    if DelayReturnTime > 0 then
        for i = DelayReturnTime, 1, -1 do
            StatusText.Text = LangData[CurrentLang]["Detected"] .. " (" .. i .. "s)"
            task.wait(1)
        end
    end

    StatusText.Text = LangData[CurrentLang]["Detected"]

    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")

    if hrp and SavedCFrame then
        local bv = Instance.new("BodyVelocity")
        bv.MaxForce = Vector3.new(1e9, 1e9, 1e9)
        bv.Velocity = Vector3.new(0, 0, 0)
        bv.Parent = hrp

        while (hrp.Position - SavedCFrame.Position).Magnitude > 6 do
            local dir = (SavedCFrame.Position - hrp.Position).Unit
            bv.Velocity = dir * FlySpeed
            task.wait(0.02)
        end

        bv:Destroy()
        hrp.CFrame = SavedCFrame
        StatusText.Text = LangData[CurrentLang]["Done"]
        task.wait(2)
    end

    StatusText.Text = LangData[CurrentLang]["CheckPet"]
    isFlyingBack = false
end

-- Lắng nghe sự kiện cầm/nhặt pet hoặc trứng vào túi
local function OnCharacterAdded(char)
    char.ChildAdded:Connect(function(child)
        -- Kiểm tra nếu vật phẩm cầm vào là Pet/Egg
        if child:IsA("Tool") or string.find(string.lower(child.Name), "egg") or string.find(string.lower(child.Name), "pet") then
            task.spawn(FlyBackToBase)
        end
    end)
end

if LocalPlayer.Character then
    OnCharacterAdded(LocalPlayer.Character)
end
LocalPlayer.CharacterAdded:Connect(OnCharacterAdded)

