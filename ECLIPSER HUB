local MainTab = containers["main"]
local GameData = {
    ["Steal an Egg"] = {["Chiliin Hub"] = "url1", ["Hoho Hub"] = "url2"},
    ["Ride a Pet"] = {["Speed Hub X"] = "url3", ["Redz Hub"] = "url4"},
    ["Clone to Steal Egg"] = {["Vortex Hub"] = "url5"},
    ["Blox Fruit"] = {["Redz Hub"] = "url6", ["W-Azure Hub"] = "url7"}
}
local SelectedGame, SelectedScript, SelectedUrl = nil, nil, nil

local GameBtn = CreateButton(MainTab, LangData[CurrentLang]["SelectGame"] .. "None", function()
    local games = {"Steal an Egg", "Ride a Pet", "Clone to Steal Egg", "Blox Fruit"}
    local idx = (table.find(games, SelectedGame) or 0) % #games + 1
    SelectedGame = games[idx]
    SelectedScript, SelectedUrl = nil, nil
    GameBtn.Text = LangData[CurrentLang]["SelectGame"] .. SelectedGame
    ScriptBtn.Text = LangData[CurrentLang]["SelectScript"] .. "None"
end)

local ScriptBtn = CreateButton(MainTab, LangData[CurrentLang]["SelectScript"] .. "None", function()
    if not SelectedGame then return end
    local sList = {}
    for name, _ in pairs(GameData[SelectedGame]) do table.insert(sList, name) end
    local idx = (table.find(sList, SelectedScript) or 0) % #sList + 1
    SelectedScript = sList[idx]
    SelectedUrl = GameData[SelectedGame][SelectedScript]
    ScriptBtn.Text = LangData[CurrentLang]["SelectScript"] .. SelectedScript
end)

CreateButton(MainTab, LangData[CurrentLang]["Execute"], function()
    if SelectedUrl then loadstring(game:HttpGet(SelectedUrl))() end
end)

