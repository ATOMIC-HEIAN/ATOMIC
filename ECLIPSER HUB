local EspV2On = false
local tEspV2, lblEspV2 = CreateToggle(VisualTab, LangData[CurrentLang]["EspV2"], function(v)
    EspV2On = v
    task.spawn(function()
        while EspV2On do
            local myChar = LocalPlayer.Character
            local myHrp = myChar and myChar:FindFirstChild("HumanoidRootPart")
            if myHrp then
                local list = {}
                for _, p in pairs(Players:GetPlayers()) do
                    if p ~= LocalPlayer and p.Character and p.Character:FindFirstChild("HumanoidRootPart") then
                        local d = (p.Character.HumanoidRootPart.Position - myHrp.Position).Magnitude
                        if d <= 250 then table.insert(list, {plr = p, dist = d}) end
                    end
                end
                table.sort(list, function(a, b) return a.dist < b.dist end)
                for i = 1, math.min(7, #list) do
                    local char = list[i].plr.Character
                    if char and not char:FindFirstChild("EclipserV2Box") then
                        local b = Instance.new("SelectionBox")
                        b.Name = "EclipserV2Box"
                        b.Color3 = Color3.fromRGB(255, 255, 255)
                        b.Adornee = char
                        b.Parent = char
                    end
                end
            end
            task.wait(0.5)
        end
        for _, p in pairs(Players:GetPlayers()) do
            if p.Character and p.Character:FindFirstChild("EclipserV2Box") then p.Character.EclipserV2Box:Destroy() end
        end
    end)
end)

