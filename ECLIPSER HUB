local function GetGameMutations()
    local list = {}
    for _, v in pairs(ReplicatedStorage:GetDescendants()) do
        if v:IsA("Folder") and (string.find(string.lower(v.Name), "mutation") or string.find(string.lower(v.Name), "trait")) then
            for _, item in pairs(v:GetChildren()) do
                table.insert(list, item.Name)
            end
        end
    end
    if #list == 0 then
        list = {"Common", "Rare", "Epic", "Legendary", "Mythic"}
    end
    return list
end

